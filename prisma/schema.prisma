generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SCHOOL_OWNER
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  TEACHER
  FOUNDER
  STUDENT
}

enum SchoolStatus {
  ACTIVE
  TRIAL
  EXPIRED
  SUSPENDED
  /**
   * Founder has scheduled tenant-data purge; restorable until deletionScheduledFor.
   */
  PENDING_DELETION
  /**
   * Purge job has started removing tenant data; no longer restorable.
   */
  DELETING
  /**
   * Purge job failed and needs retry (see School.deletionRetryCount/deletionLastError).
   */
  DELETION_FAILED
  /**
   * Purge completed — tenant data removed; row kept as a tombstone.
   */
  DELETED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum FeatureFlagKey {
  ATTENDANCE
  HOMEWORK
  FEES
  REPORT_CARDS
  REPORT_CARD_BUILDER
  MOBILE_APP
  PARENT_PORTAL
  STUDENT_PORTAL
  NOTIFICATIONS
  ANALYTICS
  WHITE_LABEL
  TEACHER_PERMISSIONS
  AI_FEATURES
  NOTEBOOK_CHECKING
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  SCHOOL_REGISTERED
  PAYMENT_PROOF_SUBMITTED
  SUBSCRIPTION_EXPIRING
  INVOICE_OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceType {
  STUDENT
  TEACHER
}

enum LeaveType {
  STUDENT
  TEACHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HomeworkStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

// Homework 2.0: explicit assessment mode chosen at creation time.
// CHECKING_ONLY: notebook/completion checking, marks never accepted.
// GRADED: marks required (Homework.maxMarks) and validated per student.
// Legacy rows (created before this mode existed) are backfilled
// deterministically — see migration 20260716000000_homework_v2's comment
// and docs in src/lib/homework.ts.
enum HomeworkAssessmentMode {
  CHECKING_ONLY
  GRADED
}

enum HomeworkStudentSubmissionStatus {
  PENDING
  SUBMITTED
  NOT_SUBMITTED
  LATE
  CHECKED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  LATE
  REVIEWED
  REJECTED
}

enum HomeworkAcademicSubmissionStatus {
  PENDING
  SUBMITTED
  LATE_SUBMITTED
  NOT_SUBMITTED
  CHECKED
  REJECTED
}

enum HomeworkSubmissionMethod {
  NONE
  ONLINE
  PHYSICAL
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

// ── Wave B: object storage + durable jobs ────────────────────────────────────

enum StoredFileVisibility {
  PUBLIC
  TENANT_PRIVATE
  SCOPED_PRIVATE
  BILLING_PRIVATE
}

enum StoredFileCategory {
  BRANDING_IMAGE
  HOMEWORK_ATTACHMENT
  HOMEWORK_SUBMISSION
  PAYMENT_PROOF
  REPORT_CARD_ASSET
  STUDENT_IMPORT_SOURCE
}

// Uploader may be a User (staff), a Guardian (parent) or a Student — none of
// which share one FK table — so uploader identity is recorded as an actor
// type + id rather than a single foreign key.
enum FileUploaderActorType {
  USER
  GUARDIAN
  STUDENT
  SYSTEM
}

enum JobType {
  REPORT_CARD_BATCH_GENERATION
  STUDENT_BULK_IMPORT
  SMART_TIMETABLE_GENERATION
  FILE_RETENTION_CLEANUP
  SCHOOL_DATA_PURGE
  // Durable outbox record for the Founder "Add School" admin invite (see
  // src/lib/school-onboarding.ts): created in the SAME transaction as the
  // School/SchoolSubscription/SchoolInvite rows, so a crash after commit but
  // before the email is sent can never leave the invite permanently
  // unsent — the standalone worker will still find and process this row.
  INVITE_EMAIL_DELIVERY
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                                String                      @id @default(cuid())
  name                              String
  email                             String                      @unique
  password                          String
  role                              UserRole                    @default(SCHOOL_OWNER)
  schoolId                          String?
  school                            School?                     @relation("SchoolAdmins", fields: [schoolId], references: [id])
  ownedSchool                       School?                     @relation("SchoolOwner")
  invitesSent                       SchoolInvite[]              @relation("InviteSender")
  attendancesMarked                 Attendance[]
  teacherProfile                    Teacher?                    @relation("TeacherUser")
  examResultsSubmitted              ExamResult[]                @relation("ResultSubmitter")
  announcements                     Announcement[]
  feePaymentsRecorded               FeePayment[]                @relation("FeeRecorder")
  leavesReviewed                    LeaveRequest[]              @relation("LeaveReviewer")
  earlyLeavesReviewed               TeacherEarlyLeaveRequest[]  @relation("EarlyLeaveApprover")
  transfersBy                       SectionTransfer[]           @relation("TransferBy")
  auditLogs                         AuditLog[]                  @relation("AuditUser")
  paymentProofsSubmitted            PaymentProofSubmission[]    @relation("PaymentProofSubmitter")
  paymentProofsReviewed             PaymentProofSubmission[]    @relation("PaymentProofReviewer")
  invoicesCreated                   Invoice[]                   @relation("InvoiceCreator")
  teachersDeleted                   Teacher[]                   @relation("TeacherDeletedBy")
  operationalRoleAssignmentsCreated OperationalRoleAssignment[] @relation("OperationalRoleAssignmentCreatedBy")
  passwordResetTokens               PasswordResetToken[]
  timetableDraftsCreated            TimetableDraft[]            @relation("TimetableDraftCreatedBy")
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model School {
  id                                   String                        @id @default(cuid())
  name                                 String
  slug                                 String                        @unique
  address                              String?
  phone                                String?
  email                                String?
  website                              String?
  customDomain                         String?                       @unique
  logoUrl                              String?
  logoFileId                           String?                       @unique
  logoFile                             StoredFile?                   @relation("SchoolLogoFile", fields: [logoFileId], references: [id], onDelete: SetNull)
  primaryColor                         String?
  secondaryColor                       String?
  appName                              String?
  poweredBySchoolSync                  Boolean                       @default(true)
  status                               SchoolStatus                  @default(ACTIVE)
  periodsPerDay                        Int                           @default(6)
  teacherAttendanceCutoffTime          String                        @default("09:30")
  // School Operations Command Center: IANA timezone identifier used for every
  // "today"/"current period" calculation (src/lib/school-time.ts). No prior
  // School field expressed this explicitly — the whole app has always assumed
  // server-local time IS school-local time. This default preserves that
  // existing implicit assumption (India-first product) rather than silently
  // changing behavior for schools that never configure it.
  timezone                             String                        @default("Asia/Kolkata")
  // Smart Timetable: working days per week (1=Mon..N). Combined with
  // periodsPerDay this defines the weekly slot capacity (see
  // src/lib/timetable-capacity.ts). Nullable-free with a safe default so
  // existing schools (implicitly Mon-Sat, matching TimetableSlot.dayOfWeek
  // 1-6) behave identically until a school explicitly reconfigures it.
  timetableWorkingDays                 Int                           @default(6)
  // Teacher workload rule DEFAULTS (school-wide fallback). Nullable: when
  // unset, the effective default is derived from
  // timetableWorkingDays * periodsPerDay (see teacher-workload-rules.ts) —
  // never a hardcoded "30" for every school. A TeacherWorkloadOverride row
  // can override any of these per-teacher.
  defaultMaxWeeklyTeachingPeriods      Int?
  defaultMinFreeTeachingPeriods        Int?
  defaultMaxDailyTeachingPeriods       Int?
  defaultMaxConsecutiveTeachingPeriods Int?
  // Client-supplied idempotency key for the Founder "Add School" transaction
  // (school + subscription + admin invite created atomically) — lets a
  // retried/double submit reuse the same result instead of creating a
  // duplicate school. Null for schools created through any other path.
  creationIdempotencyKey               String?                       @unique
  // ── School lifecycle: archive / scheduled deletion / purge (smallest schema
  // change compatible with the existing SchoolStatus model — see
  // src/lib/school-deletion.ts). preDeletionStatus captures the status to
  // restore to if the Founder cancels/restores before the retention window
  // elapses; the rest track the request, the purge job, and failure/retry.
  preDeletionStatus                    SchoolStatus?
  deletionRequestedAt                  DateTime?
  deletionRequestedById                String?
  deletionScheduledFor                 DateTime?
  deletionCancelledAt                  DateTime?
  deletionJobId                        String?
  deletionRetryCount                   Int                           @default(0)
  // Sanitized, bounded operator-facing message only — never raw error/stack/PII.
  deletionLastError                    String?
  ownerId                              String?                       @unique
  owner                                User?                         @relation("SchoolOwner", fields: [ownerId], references: [id])
  admins                               User[]                        @relation("SchoolAdmins")
  classes                              Class[]
  subjects                             Subject[]
  teachers                             Teacher[]
  students                             Student[]
  guardians                            Guardian[]
  studentGuardians                     StudentGuardian[]
  invites                              SchoolInvite[]
  attendances                          Attendance[]
  timetableSlots                       TimetableSlot[]
  examSchemes                          ExamScheme[]
  announcements                        Announcement[]
  announcementTargets                  AnnouncementTarget[]
  announcementReads                    AnnouncementRead[]
  holidays                             Holiday[]
  feeStructures                        FeeStructure[]
  feePayments                          FeePayment[]
  reportCards                          ReportCard[]
  leaveRequests                        LeaveRequest[]
  homework                             Homework[]
  homeworkSubmissions                  HomeworkSubmission[]
  examMilestones                       ExamMilestone[]
  notebookChecks                       NotebookCheck[]
  arrangements                         Arrangement[]
  earlyLeaveRequests                   TeacherEarlyLeaveRequest[]
  sectionTransfers                     SectionTransfer[]
  auditLogs                            AuditLog[]
  aiInsightCache                       AIInsightCache?
  teacherCustomRoles                   TeacherCustomRole[]
  teacherRoleAssignments               TeacherRoleAssignment[]
  reportCardTemplates                  ReportCardTemplate[]
  subscription                         SchoolSubscription?
  featureFlags                         SchoolFeatureFlag[]
  paymentProofs                        PaymentProofSubmission[]
  invoices                             Invoice[]
  notifications                        FounderNotification[]
  storedFiles                          StoredFile[]
  backgroundJobs                       BackgroundJob[]
  customDomains                        CustomDomain[]
  teacherWorkloadOverrides             TeacherWorkloadOverride[]
  teacherSubjectEligibilities          TeacherSubjectEligibility[]
  timetableSubjectRequirements         TimetableSubjectRequirement[]
  timetableDrafts                      TimetableDraft[]
  authSessions                         AuthSession[]
  authLoginEvents                      AuthLoginEvent[]
  authFailureStates                    AuthFailureState[]
  periodSchedule                       SchoolPeriodSchedule[]
  operationalRoleAssignments           OperationalRoleAssignment[]
  createdAt                            DateTime                      @default(now())
  updatedAt                            DateTime                      @updatedAt

  @@index([status, deletionScheduledFor])
}

model SchoolInvite {
  id              String            @id @default(cuid())
  name            String?
  email           String
  // Legacy opaque id (kept for backward compatibility). Security lookups use
  // tokenHash: only the SHA-256 hash of the raw token is stored; the raw token
  // lives only in the emailed link. Rows created before the hashing migration
  // have tokenHash = null and are therefore no longer resolvable.
  token           String            @unique @default(cuid())
  tokenHash       String?           @unique
  role            UserRole          @default(SCHOOL_ADMIN)
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedById     String
  invitedBy       User              @relation("InviteSender", fields: [invitedById], references: [id])
  usedAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  trialStartDate  DateTime?
  trialExpiryDate DateTime?
  billingCycle    BillingCycle?

  @@index([planId])
}

model Class {
  id                           String                        @id @default(cuid())
  name                         String
  schoolId                     String
  school                       School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections                     Section[]
  feeStructures                FeeStructure[]
  subjects                     Subject[]
  timetableSubjectRequirements TimetableSubjectRequirement[]
  timetableDrafts              TimetableDraft[]
  announcementTargets          AnnouncementTarget[]
  createdAt                    DateTime                      @default(now())

  @@unique([name, schoolId])
}

model Section {
  id                           String                        @id @default(cuid())
  name                         String
  classId                      String
  class                        Class                         @relation(fields: [classId], references: [id], onDelete: Cascade)
  students                     Student[]
  attendances                  Attendance[]
  reportCards                  ReportCard[]
  mentor                       Teacher?                      @relation("SectionMentor")
  timetableSlots               TimetableSlot[]
  homework                     Homework[]
  arrangements                 Arrangement[]
  subjects                     Subject[]
  transfersFrom                SectionTransfer[]             @relation("TransferFrom")
  transfersTo                  SectionTransfer[]             @relation("TransferTo")
  timetableSubjectRequirements TimetableSubjectRequirement[]
  timetableDrafts              TimetableDraft[]
  announcementTargets          AnnouncementTarget[]
  createdAt                    DateTime                      @default(now())

  @@unique([name, classId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([classId, sectionId, name])
  @@index([schoolId])
  @@index([classId])
}

model Teacher {
  id                         String                        @id @default(cuid())
  name                       String
  email                      String?
  phone                      String?
  subject                    String?
  schoolId                   String
  school                     School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId                     String?                       @unique
  user                       User?                         @relation("TeacherUser", fields: [userId], references: [id])
  mentorSectionId            String?                       @unique
  mentorSection              Section?                      @relation("SectionMentor", fields: [mentorSectionId], references: [id])
  invites                    TeacherInvite[]
  attendances                Attendance[]
  timetableSlots             TimetableSlot[]               @relation("TeacherSlots")
  leaveRequests              LeaveRequest[]
  homework                   Homework[]
  generatedReportCards       ReportCard[]                  @relation("ReportCardGenerator")
  arrangmentsAsAbsent        Arrangement[]                 @relation("ArrangementAbsent")
  arrangmentsAsSubstitute    Arrangement[]                 @relation("ArrangementSubstitute")
  earlyLeaveRequests         TeacherEarlyLeaveRequest[]
  roleAssignments            TeacherRoleAssignment[]
  homeworkCompletionsMarked  HomeworkStudentStatus[]       @relation("HomeworkCompletionMarker")
  notebookChecks             NotebookCheck[]
  workloadOverride           TeacherWorkloadOverride?
  subjectEligibilities       TeacherSubjectEligibility[]
  preferredForRequirements   TimetableSubjectRequirement[] @relation("PreferredTeacher")
  timetableDraftSlots        TimetableDraftSlot[]
  operationalRoleAssignments OperationalRoleAssignment[]
  isDeleted                  Boolean                       @default(false)
  deletedAt                  DateTime?
  deletedById                String?
  deletedBy                  User?                         @relation("TeacherDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  @@index([schoolId])
  @@index([schoolId, isDeleted])
}

model TeacherInvite {
  id        String    @id @default(cuid())
  email     String
  // See SchoolInvite.tokenHash — raw token is emailed, only its hash is stored.
  token     String    @unique @default(cuid())
  tokenHash String?   @unique
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  period    Int // 1, 2, 3...
  teacherId String?
  teacher   Teacher? @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: SetNull)
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, dayOfWeek, period])
}

/**
 * School Operations Command Center: the minimum honest clock-time mapping for
 * TimetableSlot.period (see src/lib/school-time.ts). Uniform across every
 * working day (no day-specific variation) — TimetableSlot itself has no
 * day-specific period-count variation either, so this matches the existing
 * architecture's granularity rather than inventing a bigger academic-calendar
 * engine. A school with NO rows here has period timing genuinely unconfigured;
 * the resolver returns an honest "not configured" state rather than fabricating
 * period times (see docs/school-operations-command-center.md).
 */
model SchoolPeriodSchedule {
  id              String  @id @default(cuid())
  schoolId        String
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodNumber    Int
  label           String?
  // Zero-padded 24h "HH:MM" — deliberately a plain string (not DateTime): this
  // is a time-of-day, not an instant, and lexicographic string comparison of
  // zero-padded HH:MM is a correct, simple ordering — no Date/timezone parsing
  // needed to compare "is it currently within this period".
  startTime       String
  endTime         String
  isInstructional Boolean @default(true)

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
}

// ── Smart Timetable ──────────────────────────────────────────────────────────
// LIVE timetable stays exactly TimetableSlot above (unchanged, still what
// teacher schedules/attendance/substitutions/arrangements read). Everything
// below is DRAFT-only generation/planning state — a draft is never read by
// any operational consumer until explicitly published (see
// src/lib/smart-timetable-publish.ts), which copies its slots into
// TimetableSlot atomically. See docs/smart-timetable-architecture.md.

/**
 * Per-teacher override of the school's default workload rule fields (any field left null falls back to the School default, which itself falls back to a working-days*periodsPerDay-derived value — see teacher-workload-rules.ts).
 */
model TeacherWorkloadOverride {
  id                            String   @id @default(cuid())
  teacherId                     String   @unique
  teacher                       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId                      String
  school                        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  maxWeeklyTeachingPeriods      Int?
  minFreeTeachingPeriods        Int?
  maxDailyTeachingPeriods       Int?
  maxConsecutiveTeachingPeriods Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([schoolId])
}

/**
 * Explicit teacher-can-teach-subject eligibility (subject identified by name, matching the existing free-text convention already used by Teacher.subject / TimetableSlot.subject — there is no global per-school Subject catalog; see baseline audit in docs/smart-timetable-architecture.md). A teacher with no rows here falls back to eligibility via their single Teacher.subject field (backward compatible with every teacher seeded before this feature existed).
 */
model TeacherSubjectEligibility {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectName String
  createdAt   DateTime @default(now())

  @@unique([teacherId, subjectName])
  @@index([schoolId, subjectName])
}

/**
 * Weekly period requirement for one subject in one class/section's timetable (used for capacity validation + generation, not the live TimetableSlot rows directly).
 */
model TimetableSubjectRequirement {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId                String
  class                  Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId              String
  section                Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectName            String
  requiredPeriodsPerWeek Int
  minPeriodsPerDay       Int?
  maxPeriodsPerDay       Int?
  allowConsecutive       Boolean  @default(false)
  preferredTeacherId     String?
  preferredTeacher       Teacher? @relation("PreferredTeacher", fields: [preferredTeacherId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([sectionId, subjectName])
  @@index([schoolId])
  @@index([classId])
}

enum TimetableDraftStatus {
  DRAFT
  VALID
  INVALID
  PUBLISHED
}

enum TimetableDraftSource {
  MANUAL
  AUTO
  HYBRID
}

/**
 * A generated or manually-built timetable NOT yet published — never read by any operational consumer (teacher schedule, attendance, substitutions, arrangements). Publishing copies validated TimetableDraftSlot rows into live TimetableSlot atomically (see PART 21).
 */
model TimetableDraft {
  id             String               @id @default(cuid())
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status         TimetableDraftStatus @default(DRAFT)
  source         TimetableDraftSource @default(MANUAL)
  qualityScore   Float?
  // Small generation metadata (weights version, seed, batch id, search stats).
  // Deliberately NOT where slot data lives — see TimetableDraftSlot below.
  configSnapshot Json?
  diagnostics    Json?
  generationSeed String?
  createdById    String?
  createdBy      User?                @relation("TimetableDraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  publishedAt    DateTime?
  slots          TimetableDraftSlot[]

  @@index([schoolId])
  @@index([sectionId])
}

model TimetableDraftSlot {
  id          String         @id @default(cuid())
  draftId     String
  draft       TimetableDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  period      Int
  subjectName String?
  teacherId   String?
  teacher     Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  locked      Boolean        @default(false)
  source      String?
  reasonCode  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([draftId, dayOfWeek, period])
  @@index([teacherId])
}

model ExamScheme {
  id          String       @id @default(cuid())
  name        String
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams       Exam[]
  reportCards ReportCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, schoolId])
}

model Exam {
  id        String       @id @default(cuid())
  name      String
  maxMarks  Int
  order     Int          @default(0)
  schemeId  String
  scheme    ExamScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  results   ExamResult[]
  createdAt DateTime     @default(now())
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks         Float
  submittedById String
  submittedBy   User     @relation("ResultSubmitter", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model Student {
  id                  String                  @id @default(cuid())
  name                String
  rollNo              String
  admissionNo         String?
  email               String?
  phone               String?
  passwordHash        String?
  parentName          String?
  parentPhone         String?
  fatherName          String?
  fatherPhone         String?
  fatherPhoneHash     String?
  motherName          String?
  motherPhone         String?
  motherPhoneHash     String?
  sectionId           String
  section             Section                 @relation(fields: [sectionId], references: [id])
  schoolId            String
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendances         Attendance[]
  examResults         ExamResult[]
  reportCards         ReportCard[]
  homeworkStatuses    HomeworkStudentStatus[]
  homeworkSubmissions HomeworkSubmission[]
  notebookChecks      NotebookCheck[]
  guardianLinks       StudentGuardian[]
  feePayments         FeePayment[]
  leaveRequests       LeaveRequest[]
  sectionTransfers    SectionTransfer[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([rollNo, schoolId])
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
