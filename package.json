{
  "name": "schoolsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "seed:pilot": "tsx scripts/seed-pilot.ts",
    "pilot:verify": "tsx scripts/pilot-verify.ts",
    "pilot:verify:smart-timetable": "tsx scripts/smart-timetable-pilot-verify.ts",
