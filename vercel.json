{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/internal/cron/school-purge", "schedule": "0 1 * * *" },
    { "path": "/api/internal/cron/file-retention", "schedule": "0 2 * * *" },
    { "path": "/api/internal/cron/worker", "schedule": "0 3 * * *" }
  ]
}
