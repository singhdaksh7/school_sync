# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Exception: the vendored AWS RDS CA bundle is public (no private key, see
# certs/README.md) and must be committed — the runtime image trusts it via
# NODE_EXTRA_CA_CERTS instead of disabling certificate verification.
!certs/aws-rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
# Added by code-review-graph
.code-review-graph/

# terraform (note: .terraform.lock.hcl is intentionally NOT ignored — commit it)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
infra/terraform/backend.hcl
crash.log
crash.*.log

# graphify knowledge-graph output (generated, regenerable via `graphify update .`)
graphify-out/
**/graphify-out/
