model SectionTransfer {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSectionId   String
  fromSection     Section  @relation("TransferFrom", fields: [fromSectionId], references: [id], onDelete: Cascade)
  toSectionId     String
  toSection       Section  @relation("TransferTo", fields: [toSectionId], references: [id], onDelete: Cascade)
  reason          String?
  transferredById String
  transferredBy   User     @relation("TransferBy", fields: [transferredById], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. STUDENT_CREATED, MARKS_SUBMITTED, LEAVE_APPROVED
  entityType String // e.g. Student, Teacher, ExamResult
  entityId   String?
  metadata   String? // JSON string of relevant details
  userId     String
  user       User     @relation("AuditUser", fields: [userId], references: [id])
  actorRole  String? // role of the user at the time of the action
  ipAddress  String? // best-effort, from x-forwarded-for/x-real-ip
  schoolId   String? // null for platform-level Founder actions not tied to one school (e.g. plan changes)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType])
  @@index([userId])
  @@index([createdAt])
}

model AIInsightCache {
  id          String   @id @default(cuid())
  schoolId    String   @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  insights    String // JSON string
  generatedAt DateTime @default(now())
}

model TeacherEarlyLeaveRequest {
  id               String      @id @default(cuid())
  schoolId         String
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date             DateTime    @db.Date
  leaveAfterPeriod Int // teacher leaves after this period; later periods need substitutes
  reason           String
  status           LeaveStatus @default(PENDING)
  approvedById     String?
  approvedBy       User?       @relation("EarlyLeaveApprover", fields: [approvedById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, date])
  @@index([teacherId])
}

// ─── Custom teacher roles & permissions ──────────────────────────────────────
// Additive RBAC layer. The base UserRole (incl. TEACHER) keeps its existing
// access; these models only matter where teacher-permissions.ts is consulted.

model TeacherCustomRole {
  id          String                  @id @default(cuid())
  schoolId    String
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions TeacherPermission[]
  assignments TeacherRoleAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherPermission {
  id      String            @id @default(cuid())
  roleId  String
  role    TeacherCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String // e.g. STUDENTS, ATTENDANCE, HOMEWORK, MARKS, REPORT_CARDS, FEES, TEACHERS, ANNOUNCEMENTS, SETTINGS
  action  String // e.g. VIEW, CREATE, MARK, REPORTS, MANAGE_ALL ...
  allowed Boolean           @default(true)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model TeacherRoleAssignment {
  id         String            @id @default(cuid())
  teacherId  String
  teacher    Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  roleId     String
  role       TeacherCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classIds   Json? // optional list of class ids this assignment is scoped to; empty/null = whole school
  sectionIds Json? // optional list of section ids this assignment is scoped to
  createdAt  DateTime          @default(now())

  @@unique([teacherId, roleId])
  @@index([teacherId])
  @@index([roleId])
  @@index([schoolId])
}

/**
 * Teacher Operations Head & Automatic Delegation (Phase 3). An ORDERED
 * leadership chain per (schoolId, roleType) — priority 0 is Primary, priority
 * > 0 is an Alternate, in ascending priority order. Deliberately NOT a fixed
 * set of School.primaryTeacherId/alternateTeacherId columns — an arbitrary
 * number of ordered alternates must be representable.
 * `roleType` is a plain String (not a Prisma enum) matching the existing
 * FeeStructure.frequency precedent in this schema — new role types (e.g. a
 * future Academic Head) can be introduced without a schema migration, while
 * only "TEACHER_OPERATIONS" is actually used/validated in this phase (see
 * OPERATIONAL_ROLE_TYPES in operational-roles.ts).
 * This table is NEVER mutated by the effective-head resolver — availability
 * (leave/attendance/deletion/effective dates) is computed dynamically at read
 * time from already-existing facts (LeaveRequest, Attendance, Teacher.isDeleted).
 * No permission rows are ever copied onto an alternate.
 */
model OperationalRoleAssignment {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleType       String // "TEACHER_OPERATIONS" (see OPERATIONAL_ROLE_TYPES)
  teacherId      String
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  priority       Int // 0 = Primary, 1..N = Alternate 1..N, ascending = failover order
  isEnabled      Boolean   @default(true)
  effectiveFrom  DateTime? @db.Date
  effectiveUntil DateTime? @db.Date
  createdById    String?
  createdBy      User?     @relation("OperationalRoleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // One assignment per teacher per role per school, and one teacher per
  // priority slot per role per school — both DB-enforced, not just
  // pre-validated in application code (PART 32 concurrency safety).
  @@unique([schoolId, roleType, teacherId])
  @@unique([schoolId, roleType, priority])
  @@index([teacherId])
}

// ─── SaaS billing foundations (Founder portal) ───────────────────────────────
// Schema-only foundation for Phase 2. No invoicing/payment-gateway/automation
// yet — `amount` is a snapshot taken at assignment time so historic revenue
// stays accurate even if a plan's price changes later.

model SubscriptionPlan {
  id                String               @id @default(cuid())
  name              String               @unique
  // Immutable after creation (never updated by the PATCH route) — serves as
  // the ticket's "stable unique plan code"; reusing this existing field
  // instead of adding a redundant one.
  slug              String               @unique
  description       String?
  // ISO 4217 code. India-first product (School.timezone defaults to
  // Asia/Kolkata) so INR is the default, not a guess.
  currency          String               @default("INR")
  // Legacy display-precision decimal prices, kept for existing read paths
  // (BillingPlansClient, invoices) — priceMonthlyMinor/priceAnnualMinor below
  // are the canonical integer-minor-unit source of truth going forward.
  priceMonthly      Decimal              @db.Decimal(10, 2)
  priceAnnual       Decimal              @db.Decimal(10, 2)
  // Canonical monetary values in integer minor units (paise for INR) — never
  // floating point. Kept in sync with priceMonthly/priceAnnual by the plan
  // CRUD routes (src/app/api/founder/plans).
  priceMonthlyMinor Int                  @default(0)
  priceAnnualMinor  Int                  @default(0)
  maxStudents       Int?
  staffLimit        Int?
  // Default feature-entitlement template for schools created on this plan —
  // copied into that school's SchoolFeatureFlag rows at creation time; does
  // not itself gate anything at runtime (SchoolFeatureFlag remains the single
  // enforcement source, see src/lib/feature-flags).
  enabledFeatures   FeatureFlagKey[]     @default([])
  isActive          Boolean              @default(true)
  subscriptions     SchoolSubscription[]
  invoices          Invoice[]
  schoolInvites     SchoolInvite[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model SchoolSubscription {
  id               String           @id @default(cuid())
  schoolId         String           @unique
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  billingCycle     BillingCycle     @default(MONTHLY)
  amount           Decimal          @db.Decimal(10, 2)
  startedAt        DateTime         @default(now())
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([planId])
}

// Minimal, non-PII deletion audit trail (ticket requirement: "actor ID,
// school ID/hash, timestamps, status and aggregate deletion counts" only —
// never student names/emails/tokens/filenames). Deliberately has NO Prisma
// relation to School or User (plain scalar id columns, same pattern already
// used for AuthSession/AuthLoginEvent actor fields) so this row survives
// both the eventual School row purge AND any future User deletion — it must
// outlive the very entities it's auditing the deletion of.
model SchoolDeletionAudit {
  id        String                    @id @default(cuid())
  schoolId  String
  actorId   String
  action    SchoolDeletionAuditAction
  status    String
  // Aggregate counts only, e.g. {"students":812,"teachers":40} — never row
  // contents, names, or identifiers.
  counts    Json?
  createdAt DateTime                  @default(now())

  @@index([schoolId, createdAt])
}

enum SchoolDeletionAuditAction {
  SCHEDULED
  CANCELLED
  RESTORED
  PURGE_STARTED
  PURGE_PROGRESS
  PURGE_COMPLETED
  PURGE_FAILED
}

// ─── Phase 3: feature flags, manual billing operations, notifications ───────
// All manual/CRUD — no automated billing, no payment gateway, no cron jobs.

model SchoolFeatureFlag {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       FeatureFlagKey
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

// receiptData stores the file as a base64 data URL directly on the row
// (capped ~2MB at the API layer) — there is no file-storage provider
// configured for this project yet.
model PaymentProofSubmission {
  id              String             @id @default(cuid())
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billingMonth    DateTime           @db.Date
  paymentDate     DateTime           @db.Date
  amount          Decimal            @db.Decimal(10, 2)
  transactionRef  String?
  notes           String?
  receiptData     String?
  receiptFileId   String?            @unique
  receiptFile     StoredFile?        @relation("PaymentProofReceiptFile", fields: [receiptFileId], references: [id], onDelete: SetNull)
  receiptFileName String?
  receiptMimeType String?
  status          PaymentProofStatus @default(PENDING)
  reviewNotes     String?
  submittedById   String
  submittedBy     User               @relation("PaymentProofSubmitter", fields: [submittedById], references: [id])
  reviewedById    String?
  reviewedBy      User?              @relation("PaymentProofReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([schoolId, status])
  @@index([schoolId])
}

model Invoice {
  id                 String            @id @default(cuid())
  invoiceNumber      String            @unique
  schoolId           String
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId             String?
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount             Decimal           @db.Decimal(10, 2)
  billingPeriodStart DateTime          @db.Date
  billingPeriodEnd   DateTime          @db.Date
  dueDate            DateTime          @db.Date
  status             InvoiceStatus     @default(DRAFT)
  notes              String?
  createdById        String
  createdBy          User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([schoolId, status])
  @@index([schoolId])
  @@index([planId])
}

model FounderNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  schoolId  String?
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
  @@index([schoolId])
}

// Durable metadata for objects stored in the object-storage provider. Bytes live
// in the provider, never in Postgres. storageKey is server-generated and
// tenant-namespaced (see src/lib/storage.ts). Replacement creates a NEW row +
// NEW immutable object key so historical references never change under callers.
model StoredFile {
  id               String                @id @default(cuid())
  schoolId         String?
  school           School?               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  storageKey       String                @unique
  originalFilename String
  contentType      String
  sizeBytes        Int
  checksum         String?
  category         StoredFileCategory
  visibility       StoredFileVisibility
  uploaderType     FileUploaderActorType @default(USER)
  uploaderId       String?
  // File retention (Cost Guard). retentionPolicy classifies the category's
  // deletion semantics; expiresAt is server-derived (never client-supplied —
  // see src/lib/file-retention.ts) and only meaningful for EXPIRING files;
  // deletedAt is a tombstone (logical delete) — the object is removed from
  // storage but the row is kept for audit/idempotent-retry safety. The
  // serving route (/api/files/[fileId]) must reject any row with deletedAt set.
  retentionPolicy  FileRetentionPolicy   @default(REFERENCE_MANAGED)
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  schoolLogoFor                   School?                 @relation("SchoolLogoFile")
  reportCardTemplateLogoFor       ReportCardTemplate?     @relation("ReportCardTemplateLogoFile")
  reportCardTemplateStampFor      ReportCardTemplate?     @relation("ReportCardTemplateStampFile")
  reportCardTemplateSignatureFor  ReportCardTemplate?     @relation("ReportCardTemplateSignatureFile")
  homeworkAttachmentFor           Homework?               @relation("HomeworkAttachmentFile")
  homeworkSubmissionAttachmentFor HomeworkSubmission?     @relation("HomeworkSubmissionAttachmentFile")
  paymentProofReceiptFor          PaymentProofSubmission? @relation("PaymentProofReceiptFile")

  @@index([schoolId, category, createdAt])
  @@index([schoolId, createdAt])
  @@index([expiresAt, deletedAt])
}

enum FileRetentionPolicy {
  /**
   * Has a computed expiresAt; eligible for automatic cleanup once past it.
   */
  EXPIRING
  /**
   * Never auto-expires (e.g. SaaS payment proofs).
   */
  LONG_TERM
  /**
   * Retained while referenced by its owning entity; not age-deleted (e.g. report-card assets, branding images).
   */
  REFERENCE_MANAGED
}

// ── Cost Guard / Session Hardening ────────────────────────────────────────────
// See docs/cost-guard-session-architecture.md. Actor identity fields
// (userId/teacherId/guardianId/studentId) are deliberately plain scalar
// columns, not Prisma relations — these are high-write, ephemeral tracking
// tables, not core domain entities; the school-tenant boundary (the field
// that actually matters for isolation) IS a proper relation below.

enum SessionActorType {
  PARENT
  STUDENT
  TEACHER
  /**
   * SCHOOL_OWNER / SCHOOL_ADMIN / VICE_PRINCIPAL, treated as one policy bucket per product decision (see docs).
   */
  ADMIN_STAFF
}

/**
 * A revocable mobile/API session — the server-side counterpart to a signed mobile JWT's `sid` claim (see src/lib/auth-sessions.ts). Never stores the raw token.
 */
model AuthSession {
  id                   String           @id @default(cuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorType            SessionActorType
  userId               String?
  teacherId            String?
  guardianId           String?
  studentId            String?
  sessionTokenHash     String           @unique
  deviceInstallationId String?
  deviceName           String?
  platform             String?
  createdAt            DateTime         @default(now())
  lastSeenAt           DateTime         @default(now())
  expiresAt            DateTime
  idleExpiresAt        DateTime?
  revokedAt            DateTime?
  revokeReason         String?

  @@index([schoolId, actorType, userId])
  @@index([schoolId, actorType, teacherId])
  @@index([schoolId, actorType, guardianId])
  @@index([schoolId, actorType, studentId])
  @@index([expiresAt])
}

/**
 * One row per successful credential-based login — the durable rolling-24h quota source (src/lib/auth-login-quota.ts). Bounded by createdAt-indexed queries; not an unbounded history table in practice (see retention note in docs).
 */
model AuthLoginEvent {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorType  SessionActorType
  userId     String?
  teacherId  String?
  guardianId String?
  studentId  String?
  ipHash     String?
  createdAt  DateTime         @default(now())

  @@index([schoolId, actorType, userId, createdAt])
  @@index([schoolId, actorType, teacherId, createdAt])
  @@index([schoolId, actorType, guardianId, createdAt])
  @@index([schoolId, actorType, studentId, createdAt])
  @@index([createdAt])
}

/**
 * Atomic failed-password escalation state per (school + normalized identifier + auth flow) bucket — never keyed on confirmed account existence (src/lib/auth-failure.ts).
 */
model AuthFailureState {
  id              String    @id @default(cuid())
  bucketKey       String    @unique
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authFlow        String
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  lastFailureAt   DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([schoolId])
  @@index([lockedUntil])
}

// Durable background-job records. Result payloads are bounded summaries only —
// never large source files or generated documents.
model BackgroundJob {
  id                 String    @id @default(cuid())
  schoolId           String?
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type               JobType
  status             JobStatus @default(PENDING)
  payload            Json
  totalItems         Int       @default(0)
  processedItems     Int       @default(0)
  failedItems        Int       @default(0)
  progress           Int       @default(0)
  resultMetadata     Json?
  errorSummary       String?
  createdById        String?
  claimToken         String?
  claimedAt          DateTime?
  leaseExpiresAt     DateTime?
  attempts           Int       @default(0)
  // Stable hash of (type + normalized payload) — lets job creation reuse an
  // existing PENDING/RUNNING equivalent job instead of creating a duplicate
  // (see src/lib/job-dedup.ts). Null for job types that don't opt in.
  payloadFingerprint String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt
  // NOTE (Phase 4, PART 11): a PARTIAL UNIQUE INDEX also exists on
  // (schoolId, type, payloadFingerprint) WHERE status IN ('PENDING','RUNNING')
  // AND payloadFingerprint IS NOT NULL — hand-authored in migration
  // 20260709000000_job_dedup_active_unique_index since Prisma's schema
  // language has no partial-index attribute. It is intentionally NOT
  // expressed here as a `@@unique` (which cannot express the WHERE clause);
  // `npx prisma migrate diff`/`db pull` will never "see" it and must not be
  // used to silently drop it. See src/lib/jobs.ts's createJob for the
  // P2002-catch application-side half of this concurrency closure.
  // CAVEAT (verified against real Postgres, Phase 4): standard Postgres
  // unique indexes treat NULL as distinct from NULL, so this index does NOT
  // dedupe two active jobs that both have schoolId = NULL. Currently
  // harmless — every job type that sets payloadFingerprint (
  // REPORT_CARD_BATCH_GENERATION, SMART_TIMETABLE_GENERATION) always passes
  // a real schoolId; only FILE_RETENTION_CLEANUP uses schoolId: null, and it
  // never sets payloadFingerprint, so it falls outside this index's WHERE
  // clause entirely. If a future job type combines schoolId: null with
  // payloadFingerprint-based dedup, this index would need `NULLS NOT
  // DISTINCT` (Postgres 15+) added to actually close that case.

  @@index([status, createdAt])
  @@index([schoolId, createdAt])
  @@index([type, status])
  @@index([schoolId, type, status, payloadFingerprint])
}

// ── Wave C: custom-domain ownership verification ─────────────────────────────
// Separate from the legacy School.customDomain free-text field (kept, unused
// for host resolution, for historical display only — see resolveSchool in
// src/lib/school-resolver.ts). A hostname only resolves a school for public
// serving once it reaches VERIFIED via a DNS TXT ownership check; PENDING/
// FAILED/DISABLED never do (see src/lib/custom-domain.ts).

enum CustomDomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  FAILED
  DISABLED
}

model CustomDomain {
  id                 String             @id @default(cuid())
  schoolId           String
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostname           String
  normalizedHostname String             @unique
  status             CustomDomainStatus @default(PENDING)
  verificationMethod String             @default("DNS_TXT")
  verificationToken  String
  lastCheckedAt      DateTime?
  verifiedAt         DateTime?
  failureReason      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([schoolId])
  @@index([status])
}
