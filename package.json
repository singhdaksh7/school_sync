    "maintenance:file-retention": "tsx scripts/maintenance-file-retention.ts",
    "maintenance:school-purge": "tsx scripts/maintenance-school-purge.ts",
    "scripts:typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "prisma:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
