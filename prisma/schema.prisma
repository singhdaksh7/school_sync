generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SCHOOL_OWNER
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  TEACHER
  FOUNDER
}

enum SchoolStatus {
  ACTIVE
  TRIAL
  EXPIRED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum FeatureFlagKey {
  ATTENDANCE
  HOMEWORK
  FEES
  REPORT_CARDS
  REPORT_CARD_BUILDER
  MOBILE_APP
  PARENT_PORTAL
  STUDENT_PORTAL
  NOTIFICATIONS
  ANALYTICS
  WHITE_LABEL
  TEACHER_PERMISSIONS
  AI_FEATURES
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  SCHOOL_REGISTERED
  PAYMENT_PROOF_SUBMITTED
  SUBSCRIPTION_EXPIRING
  INVOICE_OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceType {
  STUDENT
  TEACHER
}

enum LeaveType {
  STUDENT
  TEACHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HomeworkStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum HomeworkStudentSubmissionStatus {
  PENDING
  SUBMITTED
  NOT_SUBMITTED
  LATE
  CHECKED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  LATE
  REVIEWED
  REJECTED
}

enum HomeworkAcademicSubmissionStatus {
  PENDING
  SUBMITTED
  LATE_SUBMITTED
  NOT_SUBMITTED
  CHECKED
  REJECTED
}

enum HomeworkSubmissionMethod {
  NONE
  ONLINE
  PHYSICAL
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                   String                     @id @default(cuid())
  name                 String
  email                String                     @unique
  password             String
  role                 UserRole                   @default(SCHOOL_OWNER)
  schoolId             String?
  school               School?                    @relation("SchoolAdmins", fields: [schoolId], references: [id])
  ownedSchool          School?                    @relation("SchoolOwner")
  invitesSent          SchoolInvite[]             @relation("InviteSender")
  attendancesMarked    Attendance[]
  teacherProfile       Teacher?                   @relation("TeacherUser")
  examResultsSubmitted ExamResult[]               @relation("ResultSubmitter")
  announcements        Announcement[]
  feePaymentsRecorded  FeePayment[]               @relation("FeeRecorder")
  leavesReviewed       LeaveRequest[]             @relation("LeaveReviewer")
  earlyLeavesReviewed  TeacherEarlyLeaveRequest[] @relation("EarlyLeaveApprover")
  transfersBy          SectionTransfer[]          @relation("TransferBy")
  auditLogs            AuditLog[]                 @relation("AuditUser")
  paymentProofsSubmitted PaymentProofSubmission[] @relation("PaymentProofSubmitter")
  paymentProofsReviewed  PaymentProofSubmission[] @relation("PaymentProofReviewer")
  invoicesCreated        Invoice[]                @relation("InvoiceCreator")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model School {
  id                          String                     @id @default(cuid())
  name                        String
  slug                        String                     @unique
  address                     String?
  phone                       String?
  email                       String?
  website                     String?
  customDomain                String?                    @unique
  logoUrl                     String?
  primaryColor                String?
  secondaryColor              String?
  appName                     String?
  poweredBySchoolSync         Boolean                    @default(true)
  status                      SchoolStatus               @default(ACTIVE)
  periodsPerDay               Int                        @default(6)
  teacherAttendanceCutoffTime String                     @default("09:30")
  ownerId                     String                     @unique
  owner                       User                       @relation("SchoolOwner", fields: [ownerId], references: [id])
  admins                      User[]                     @relation("SchoolAdmins")
  classes                     Class[]
  teachers                    Teacher[]
  students                    Student[]
  guardians                   Guardian[]
  studentGuardians            StudentGuardian[]
  invites                     SchoolInvite[]
  attendances                 Attendance[]
  timetableSlots              TimetableSlot[]
  examSchemes                 ExamScheme[]
  announcements               Announcement[]
  holidays                    Holiday[]
  feeStructures               FeeStructure[]
  feePayments                 FeePayment[]
  reportCards                 ReportCard[]
  leaveRequests               LeaveRequest[]
  homework                    Homework[]
  homeworkSubmissions         HomeworkSubmission[]
  arrangements                Arrangement[]
  earlyLeaveRequests          TeacherEarlyLeaveRequest[]
  sectionTransfers            SectionTransfer[]
  auditLogs                   AuditLog[]
  aiInsightCache              AIInsightCache?
  teacherCustomRoles          TeacherCustomRole[]
  teacherRoleAssignments      TeacherRoleAssignment[]
  reportCardTemplates         ReportCardTemplate[]
  subscription                SchoolSubscription?
  featureFlags                SchoolFeatureFlag[]
  paymentProofs                PaymentProofSubmission[]
  invoices                     Invoice[]
  notifications                FounderNotification[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

model SchoolInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique @default(cuid())
  role        UserRole  @default(SCHOOL_ADMIN)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id])
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Class {
  id            String         @id @default(cuid())
  name          String
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  feeStructures FeeStructure[]
  createdAt     DateTime       @default(now())

  @@unique([name, schoolId])
}

model Section {
  id             String            @id @default(cuid())
  name           String
  classId        String
  class          Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  students       Student[]
  attendances    Attendance[]
  reportCards    ReportCard[]
  mentor         Teacher?          @relation("SectionMentor")
  timetableSlots TimetableSlot[]
  homework       Homework[]
  arrangements   Arrangement[]
  transfersFrom  SectionTransfer[] @relation("TransferFrom")
  transfersTo    SectionTransfer[] @relation("TransferTo")
  createdAt      DateTime          @default(now())

  @@unique([name, classId])
}

model Teacher {
  id                      String                     @id @default(cuid())
  name                    String
  email                   String?
  phone                   String?
  subject                 String?
  schoolId                String
  school                  School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId                  String?                    @unique
  user                    User?                      @relation("TeacherUser", fields: [userId], references: [id])
  mentorSectionId         String?                    @unique
  mentorSection           Section?                   @relation("SectionMentor", fields: [mentorSectionId], references: [id])
  invites                 TeacherInvite[]
  attendances             Attendance[]
  timetableSlots          TimetableSlot[]            @relation("TeacherSlots")
  leaveRequests           LeaveRequest[]
  homework                Homework[]
  generatedReportCards    ReportCard[]               @relation("ReportCardGenerator")
  arrangmentsAsAbsent     Arrangement[]              @relation("ArrangementAbsent")
  arrangmentsAsSubstitute Arrangement[]              @relation("ArrangementSubstitute")
  earlyLeaveRequests      TeacherEarlyLeaveRequest[]
  roleAssignments         TeacherRoleAssignment[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([schoolId])
}

model TeacherInvite {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  period    Int // 1, 2, 3...
  teacherId String?
  teacher   Teacher? @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: SetNull)
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, dayOfWeek, period])
}

model ExamScheme {
  id          String       @id @default(cuid())
  name        String
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams       Exam[]
  reportCards ReportCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, schoolId])
}

model Exam {
  id        String       @id @default(cuid())
  name      String
  maxMarks  Int
  order     Int          @default(0)
  schemeId  String
  scheme    ExamScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  results   ExamResult[]
  createdAt DateTime     @default(now())
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks         Float
  submittedById String
  submittedBy   User     @relation("ResultSubmitter", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model Student {
  id                  String                  @id @default(cuid())
  name                String
  rollNo              String
  admissionNo         String?
  email               String?
  phone               String?
  passwordHash        String?
  parentName          String?
  parentPhone         String?
  sectionId           String
  section             Section                 @relation(fields: [sectionId], references: [id])
  schoolId            String
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendances         Attendance[]
  examResults         ExamResult[]
  reportCards         ReportCard[]
  homeworkStatuses    HomeworkStudentStatus[]
  homeworkSubmissions HomeworkSubmission[]
  guardianLinks       StudentGuardian[]
  feePayments         FeePayment[]
  leaveRequests       LeaveRequest[]
  sectionTransfers    SectionTransfer[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([rollNo, schoolId])
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([sectionId])
  @@index([schoolId, sectionId])
}

model Guardian {
  id                  String               @id @default(cuid())
  name                String
  phone               String
  email               String?
  passwordHash        String?
  schoolId            String
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentLinks        StudentGuardian[]
  homeworkSubmissions HomeworkSubmission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@index([phone])
}

model StudentGuardian {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationType String   @default("GUARDIAN")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, guardianId])
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
  @@index([guardianId])
}

model Attendance {
  id         String           @id @default(cuid())
  date       DateTime         @db.Date
  type       AttendanceType
  status     AttendanceStatus
  studentId  String?
  student    Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId  String?
  teacher    Teacher?         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    Section?         @relation(fields: [sectionId], references: [id])
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  markedById String
  markedBy   User             @relation(fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([date, studentId])
  @@unique([date, teacherId])
  @@index([schoolId, date, type])
  @@index([schoolId, type])
  @@index([studentId])
  @@index([teacherId])
}

model ReportCard {
  id                   String              @id @default(cuid())
  schoolId             String
  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId            String
  section              Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  examSchemeId         String
  examScheme           ExamScheme          @relation(fields: [examSchemeId], references: [id], onDelete: Cascade)
  generatedByTeacherId String
  generatedByTeacher   Teacher             @relation("ReportCardGenerator", fields: [generatedByTeacherId], references: [id])
  status               ReportCardStatus    @default(DRAFT)
  classTeacherRemark   String?
  attendanceSummary    String
  totalMarks           Float
  percentage           Float
  grade                String
  pdfUrl               String?
  publishedAt          DateTime?
  templateId           String?
  template             ReportCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateSnapshot     Json?
  subjects             ReportCardSubject[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([studentId, examSchemeId])
  @@index([schoolId, status])
  @@index([schoolId, sectionId, examSchemeId])
  @@index([generatedByTeacherId])
  @@index([templateId])
}

model ReportCardTemplate {
  id                           String       @id @default(cuid())
  schoolId                     String
  school                       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                         String
  description                  String?
  isDefault                    Boolean      @default(false)
  assignedClassIds             Json?
  layoutType                   String       @default("CLASSIC")
  paperSize                    String       @default("A4_PORTRAIT")
  logoUrl                      String?
  principalSignatureUrl        String?
  classTeacherSignatureEnabled Boolean      @default(true)
  stampUrl                     String?
  watermarkText                String?
  backgroundImageUrl           String?
  footerText                   String?
  primaryColor                 String?
  secondaryColor               String?
  showAttendance               Boolean      @default(true)
  showRank                     Boolean      @default(false)
  showGrade                    Boolean      @default(true)
  showRemarks                  Boolean      @default(true)
  showSubjectTeacherRemarks    Boolean      @default(true)
  showClassTeacherRemarks      Boolean      @default(true)
  showCoCurricular             Boolean      @default(false)
  showSkills                   Boolean      @default(false)
  showDiscipline               Boolean      @default(false)
  showAwards                   Boolean      @default(false)
  showCustomFields             Boolean      @default(false)
  gradeBands                   Json?
  subjectGroups                Json?
  customSections               Json?
  reportCards                  ReportCard[]
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@index([schoolId])
  @@index([schoolId, isDefault])
}

model ReportCardSubject {
  id                   String     @id @default(cuid())
  reportCardId         String
  reportCard           ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject              String
  marks                Float
  maxMarks             Float
  grade                String
  subjectTeacherRemark String?

  @@unique([reportCardId, subject])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, publishedAt])
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([date, schoolId])
}

model FeeStructure {
  id        String       @id @default(cuid())
  name      String
  amount    Decimal      @db.Decimal(10, 2)
  frequency String // ANNUAL, MONTHLY, ONE_TIME, QUARTERLY
  classId   String?
  class     Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments  FeePayment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model FeePayment {
  id               String       @id @default(cuid())
  amount           Decimal      @db.Decimal(10, 2)
  paidAt           DateTime?
  method           String? // CASH, ONLINE, CHEQUE, UPI
  notes            String?
  paymentGateway   String?
  gatewayOrderId   String?      @unique
  gatewayPaymentId String?      @unique
  gatewaySignature String?
  receiptNumber    String?      @unique
  status           String       @default("PAID") // PENDING, PAID, FAILED
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId   String
  feeStructure     FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  recordedById     String?
  recordedBy       User?        @relation("FeeRecorder", fields: [recordedById], references: [id])
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([schoolId, paidAt])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([feeStructureId])
}

model LeaveRequest {
  id           String        @id @default(cuid())
  type         LeaveType
  reason       String
  fromDate     DateTime      @db.Date
  toDate       DateTime      @db.Date
  status       LeaveStatus   @default(PENDING)
  studentId    String?
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      Teacher?      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?         @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  arrangements Arrangement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId, status])
  @@index([teacherId])
  @@index([studentId])
}

model Homework {
  id              String                  @id @default(cuid())
  schoolId        String
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId       String
  section         Section                 @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject         String
  title           String
  description     String?
  dueDate         DateTime
  deadlineAt      DateTime
  attachmentUrl   String?
  status          HomeworkStatus          @default(ACTIVE)
  studentStatuses HomeworkStudentStatus[]
  submissions     HomeworkSubmission[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([schoolId, dueDate])
  @@index([schoolId, deadlineAt])
  @@index([schoolId, status])
  @@index([sectionId, subject])
  @@index([teacherId])
}

model HomeworkStudentStatus {
  id               String                           @id @default(cuid())
  homeworkId       String
  homework         Homework                         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student                          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status           HomeworkStudentSubmissionStatus  @default(PENDING)
  submissionStatus HomeworkAcademicSubmissionStatus @default(PENDING)
  submissionMethod HomeworkSubmissionMethod         @default(NONE)
  submittedAt      DateTime?
  score            Float?
  maxScore         Float?
  teacherRemark    String?
  parentVisible    Boolean                          @default(true)
  checkedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([status])
}

model HomeworkSubmission {
  id               String                           @id @default(cuid())
  schoolId         String
  school           School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homeworkId       String
  homework         Homework                         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student                          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId       String?
  guardian         Guardian?                        @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  attachmentUrl    String?
  fileName         String?
  fileType         String?
  submittedAt      DateTime                         @default(now())
  status           HomeworkSubmissionStatus
  submissionStatus HomeworkAcademicSubmissionStatus @default(PENDING)
  submissionMethod HomeworkSubmissionMethod         @default(NONE)
  teacherRemark    String?
  score            Float?
  maxScore         Float?
  reviewedAt       DateTime?
  checkedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@unique([homeworkId, studentId])
  @@index([schoolId])
  @@index([homeworkId])
  @@index([studentId])
  @@index([status])
  @@index([submissionStatus])
  @@index([submissionMethod])
}

model Arrangement {
  id                  String        @id @default(cuid())
  date                DateTime      @db.Date
  dayOfWeek           Int
  period              Int
  subject             String?
  sectionId           String
  section             Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  absentTeacherId     String
  absentTeacher       Teacher       @relation("ArrangementAbsent", fields: [absentTeacherId], references: [id], onDelete: Cascade)
  substituteTeacherId String?
  substituteTeacher   Teacher?      @relation("ArrangementSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  leaveRequestId      String?
  leaveRequest        LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  schoolId            String
  school              School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())

  @@unique([date, absentTeacherId, period])
}

model SectionTransfer {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSectionId   String
  fromSection     Section  @relation("TransferFrom", fields: [fromSectionId], references: [id], onDelete: Cascade)
  toSectionId     String
  toSection       Section  @relation("TransferTo", fields: [toSectionId], references: [id], onDelete: Cascade)
  reason          String?
  transferredById String
  transferredBy   User     @relation("TransferBy", fields: [transferredById], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. STUDENT_CREATED, MARKS_SUBMITTED, LEAVE_APPROVED
  entityType String // e.g. Student, Teacher, ExamResult
  entityId   String?
  metadata   String? // JSON string of relevant details
  userId     String
  user       User     @relation("AuditUser", fields: [userId], references: [id])
  actorRole  String? // role of the user at the time of the action
  ipAddress  String? // best-effort, from x-forwarded-for/x-real-ip
  schoolId   String? // null for platform-level Founder actions not tied to one school (e.g. plan changes)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType])
  @@index([userId])
  @@index([createdAt])
}

model AIInsightCache {
  id          String   @id @default(cuid())
  schoolId    String   @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  insights    String // JSON string
  generatedAt DateTime @default(now())
}

model TeacherEarlyLeaveRequest {
  id               String      @id @default(cuid())
  schoolId         String
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date             DateTime    @db.Date
  leaveAfterPeriod Int // teacher leaves after this period; later periods need substitutes
  reason           String
  status           LeaveStatus @default(PENDING)
  approvedById     String?
  approvedBy       User?       @relation("EarlyLeaveApprover", fields: [approvedById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, date])
  @@index([teacherId])
}

// ─── Custom teacher roles & permissions ──────────────────────────────────────
// Additive RBAC layer. The base UserRole (incl. TEACHER) keeps its existing
// access; these models only matter where teacher-permissions.ts is consulted.

model TeacherCustomRole {
  id          String                  @id @default(cuid())
  schoolId    String
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions TeacherPermission[]
  assignments TeacherRoleAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherPermission {
  id      String            @id @default(cuid())
  roleId  String
  role    TeacherCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String // e.g. STUDENTS, ATTENDANCE, HOMEWORK, MARKS, REPORT_CARDS, FEES, TEACHERS, ANNOUNCEMENTS, SETTINGS
  action  String // e.g. VIEW, CREATE, MARK, REPORTS, MANAGE_ALL ...
  allowed Boolean           @default(true)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model TeacherRoleAssignment {
  id         String            @id @default(cuid())
  teacherId  String
  teacher    Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  roleId     String
  role       TeacherCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classIds   Json? // optional list of class ids this assignment is scoped to; empty/null = whole school
  sectionIds Json? // optional list of section ids this assignment is scoped to
  createdAt  DateTime          @default(now())

  @@unique([teacherId, roleId])
  @@index([teacherId])
  @@index([roleId])
  @@index([schoolId])
}

// ─── SaaS billing foundations (Founder portal) ───────────────────────────────
// Schema-only foundation for Phase 2. No invoicing/payment-gateway/automation
// yet — `amount` is a snapshot taken at assignment time so historic revenue
// stays accurate even if a plan's price changes later.

model SubscriptionPlan {
  id            String               @id @default(cuid())
  name          String               @unique
  slug          String               @unique
  priceMonthly  Decimal              @db.Decimal(10, 2)
  priceAnnual   Decimal              @db.Decimal(10, 2)
  maxStudents   Int?
  isActive      Boolean              @default(true)
  subscriptions SchoolSubscription[]
  invoices      Invoice[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SchoolSubscription {
  id               String           @id @default(cuid())
  schoolId         String           @unique
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  billingCycle     BillingCycle     @default(MONTHLY)
  amount           Decimal          @db.Decimal(10, 2)
  startedAt        DateTime         @default(now())
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([planId])
}

// ─── Phase 3: feature flags, manual billing operations, notifications ───────
// All manual/CRUD — no automated billing, no payment gateway, no cron jobs.

model SchoolFeatureFlag {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       FeatureFlagKey
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

// receiptData stores the file as a base64 data URL directly on the row
// (capped ~2MB at the API layer) — there is no file-storage provider
// configured for this project yet.
model PaymentProofSubmission {
  id              String             @id @default(cuid())
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billingMonth    DateTime           @db.Date
  paymentDate     DateTime           @db.Date
  amount          Decimal            @db.Decimal(10, 2)
  transactionRef  String?
  notes           String?
  receiptData     String
  receiptFileName String?
  receiptMimeType String?
  status          PaymentProofStatus @default(PENDING)
  reviewNotes     String?
  submittedById   String
  submittedBy     User               @relation("PaymentProofSubmitter", fields: [submittedById], references: [id])
  reviewedById    String?
  reviewedBy      User?              @relation("PaymentProofReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([schoolId, status])
  @@index([schoolId])
}

model Invoice {
  id                 String            @id @default(cuid())
  invoiceNumber      String            @unique
  schoolId           String
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId             String?
  plan               SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount             Decimal           @db.Decimal(10, 2)
  billingPeriodStart DateTime          @db.Date
  billingPeriodEnd   DateTime          @db.Date
  dueDate            DateTime          @db.Date
  status             InvoiceStatus     @default(DRAFT)
  notes              String?
  createdById        String
  createdBy          User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([schoolId, status])
  @@index([schoolId])
  @@index([planId])
}

model FounderNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  schoolId  String?
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
  @@index([schoolId])
}
