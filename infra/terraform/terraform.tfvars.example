# Copy to terraform.tfvars (gitignored) and fill in real values.
# Nothing sensitive belongs in this file — secrets are generated by Terraform
# (random_password) or, for the two optional third-party API keys below,
# should be supplied via TF_VAR_ environment variables or -var on the CLI,
# never committed here even in the real (non-example) file.

aws_region   = "ap-south-1"
project_name = "schoolsync"
environment  = "staging"

# REQUIRED: confirm the actual name of the already-existing ECR repository —
# Terraform only looks this up (data source), it will never create it.
ecr_repository_name = "schoolsync"

# Baseline image tag for the first apply. Subsequent deploys are managed by
# infra/scripts/update-web-service.ps1 / update-worker-service.ps1, not by
# re-running terraform apply with a new image_tag.
image_tag = "latest"

# Optional — leave blank to stand up HTTP-only on the ALB's default DNS name.
domain_name         = ""
route53_zone_id     = ""
alb_certificate_arn = ""
app_base_url        = ""

# Explicit email provider selection — "ses" (default, project policy) or
# "resend" (backward compatibility only). No "console": ECS tasks always run
# with NODE_ENV=production, and console is never a valid production path.
email_provider = "ses"

# REQUIRED when email_provider = "ses" (the default) — leave blank only if
# this environment should run with email unavailable. Leave blank to skip SES
# provisioning entirely.
ses_domain = ""

# Only used when email_provider = "resend" above. Leave blank; disables
# AI_FEATURES respectively for anthropic_api_key. Prefer
# `TF_VAR_resend_api_key=... terraform apply` or -var over ever writing these
# into a tfvars file.
# resend_api_key    = ""
# anthropic_api_key = ""
