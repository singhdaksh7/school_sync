# Copy to backend.hcl (gitignored — never commit real backend config) and run:
#   terraform init -backend-config=backend.hcl
#
# Use a DIFFERENT state key from the staging application stack —
# infra/terraform/backend.hcl already uses
# "schoolsync/staging/terraform.tfstate". This bootstrap stack's state must
# never be merged with, or overwrite, that key. Reusing the same bucket +
# lock table as the application stack is fine (and typical); the key must
# differ.

bucket         = "REPLACE-with-your-terraform-state-bucket"
key            = "schoolsync/bootstrap/github-oidc/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "REPLACE-with-your-terraform-lock-table"
encrypt        = true
