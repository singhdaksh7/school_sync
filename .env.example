# SchoolSync environment inventory.
# Copy to .env and fill in real values. Never commit real secrets.
#
# Classification used below:
#   REQUIRED_PRODUCTION   — the app will not run correctly in production without it
#   REQUIRED_FOR_FEATURE  — only required if the named feature/flow is used
#   OPTIONAL              — has a safe fallback/default
#   DEVELOPMENT_ONLY      — only meaningful outside production
#   LEGACY_RETIRED        — kept for historical/compatibility reasons only;
#                           the feature it once supported is retired

# ── Database (REQUIRED_PRODUCTION) ───────────────────────────────────────────
# Pooled connection string used by the running app (src/lib/prisma.ts, via
# @prisma/adapter-pg + pg.Pool).
DATABASE_URL="postgresql://user:password@host:5432/schoolsync?sslmode=require"
# Direct (non-pooled) connection used ONLY by the Prisma CLI for migrations
# (see prisma.config.ts) — falls back to DATABASE_URL if unset.
DIRECT_URL=""

# ── Auth (REQUIRED_PRODUCTION) ───────────────────────────────────────────────
# NextAuth v5 accepts either naming; set one pair consistently.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL=""

# ── Object storage (REQUIRED_FOR_FEATURE: file uploads) ──────────────────────
# STORAGE_BUCKET and STORAGE_REGION are required together to enable the
# S3-compatible storage provider (src/lib/storage-s3.ts). Without them in
# production, uploads fail safe (NotConfiguredStorageProvider) rather than
# silently using local disk/memory.
STORAGE_BUCKET=""
STORAGE_REGION=""
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY are OPTIONAL and must
# either both be set or both be left unset (one without the other is treated
# as a misconfiguration — see resolveS3Credentials in storage-s3.ts):
#   - Local development against a real S3 bucket (or an S3-compatible
#     provider like R2 with no IAM concept): set both to an access key
#     scoped to just that bucket.
#   - ECS staging/production: leave both UNSET. The AWS SDK's default
#     credential provider chain resolves credentials automatically from the
#     ECS task IAM role (temporary, auto-rotating) — no static access key is
#     ever injected into the container. See infra/terraform/s3.tf /
#     infra/terraform/iam.tf (aws_iam_role.ecs_task_web).
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Optional: only for R2/other S3-compatible endpoints (unset for real AWS S3).
STORAGE_ENDPOINT=""
# Optional: public CDN/base URL for PUBLIC-visibility objects (branding logos).
STORAGE_PUBLIC_BASE_URL=""

# ── Distributed rate limiting (REQUIRED_FOR_FEATURE: production traffic) ────
# Upstash-compatible REST Redis. Without these, rate limiting silently uses
# the in-process MemoryRateLimiter (fine for dev/test, NOT safe across
# multiple production server instances).
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# ── Background job worker (REQUIRED_FOR_FEATURE: report-card batches, bulk import) ─
# Shared secret for the internal worker endpoint (never reuse NEXTAUTH_SECRET
# or a DB credential here). See docs/worker-deployment.md.
JOB_WORKER_SECRET=""
# Only used by the standalone scripts/worker.ts process, not the app itself.
WORKER_INTERNAL_URL="http://localhost:3000/api/internal/worker"
WORKER_POLL_MS="5000"
WORKER_BATCH="10"

# ── Email (REQUIRED_FOR_FEATURE: password reset, staff invites) ─────────────
# EMAIL_PROVIDER is the explicit, case-normalized selector
# (src/lib/email.ts getEmailProviderKind()) — production must NEVER silently
# pick a provider just because its env vars happen to be set. There is no
# fallback between providers: if the selected provider's prerequisites
# aren't met, sending fails safe (never logs the message, which would
# include a password-reset link/invite token).
#   EMAIL_PROVIDER="ses"     -> AWS SES (see below). Project default/
#                               preferred provider for production.
#   EMAIL_PROVIDER="resend"  -> Resend. Kept for backward compatibility;
#                               only used when explicitly selected.
#   EMAIL_PROVIDER="console" -> logs to stdout instead of sending. Permitted
#                               only outside production (NODE_ENV!=production
#                               — refused in production even if selected).
#   unset                    -> defaults to "ses" in production, "console"
#                               in development/test.
EMAIL_PROVIDER="ses"

# AWS SES — no API key/secret env var by design. Credentials always come
# from the AWS SDK default credential provider chain: on ECS this resolves
# to the web task's IAM role (see infra/terraform/ses.tf /
# infra/terraform/iam.tf, ecs_task_web — granted ses:SendEmail/
# ses:SendRawEmail scoped to exactly the verified domain identity); in local
# development it resolves to whatever ambient AWS identity is already
# configured (`aws configure`, SSO, etc.). Required when EMAIL_PROVIDER=ses.
EMAIL_FROM=""
# AWS/SES region. Optional — only needed if SES is provisioned in a
# different region than STORAGE_REGION. Falls back to STORAGE_REGION when
# unset. One of the two must resolve for EMAIL_PROVIDER=ses to be usable.
SES_REGION=""

# Only used when EMAIL_PROVIDER="resend" above (ignored otherwise — no
# fallback between providers).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ── AI features (REQUIRED_FOR_FEATURE: AI_FEATURES flag only) ───────────────
# Only needed for schools with the AI_FEATURES catalog flag enabled. Core ERP
# functionality never depends on this.
ANTHROPIC_API_KEY=""

# ── Legacy / retired (LEGACY_RETIRED) ────────────────────────────────────────
# Online student-fee payment via Razorpay is retired — student fees are now a
# manual ledger (see AGENTS/roadmap notes). src/lib/razorpay.ts has zero
# callers; /api/webhooks/razorpay always returns `{retired: true}` without
# verifying or using these. Kept documented (not deleted) for historical
# compatibility auditing only — do not treat as active configuration.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Pilot data tooling (DEVELOPMENT_ONLY) ────────────────────────────────────
# Hard safety guard for scripts/seed-pilot.ts and scripts/pilot-verify.ts —
# see src/lib/pilot-seed-guard.ts. NEVER set ALLOW_PILOT_SEED=true against a
# production/Neon database.
ALLOW_PILOT_SEED="false"
PILOT_SEED_FORCE_HOST_CHECK="true"
PILOT_SEED=""

# ── Platform (OPTIONAL) ──────────────────────────────────────────────────────
NODE_ENV="development"
